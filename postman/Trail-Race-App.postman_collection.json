    {
      "name": "Races — Command (port 8081)",
      "description": "Mutating operations on Races. Requires **Administrator** role.\n\nRun **Login as Administrator** first.",
      "item": [
        {
          "name": "Create Race",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has id, name, distance', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('name');",
                  "    pm.expect(json).to.have.property('distance');",
                  "});",
                  "pm.test('Name matches request', function () {",
                  "    pm.expect(pm.response.json().name).to.eql('Mountain Classic');",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('race_id', json.id);",
                  "    console.log('race_id saved:', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mountain Classic\",\n  \"distance\": \"MARATHON\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{command_url}}/api/races",
              "host": ["{{command_url}}"],
              "path": ["api", "races"]
            },
            "description": "Creates a race. Saves `race_id` automatically.\n\nDistance values: `FIVE_K` | `TEN_K` | `HALF_MARATHON` | `MARATHON`"
          },
          "response": [
            {
              "name": "201 — Race Created",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"name\": \"Mountain Classic\",\n  \"distance\": \"MARATHON\"\n}"
            }
          ]
        },
        {
          "name": "Create Race — Validation Error (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Response contains error details', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('detail');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"distance\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{command_url}}/api/races",
              "host": ["{{command_url}}"],
              "path": ["api", "races"]
            },
            "description": "Negative test: empty name and null distance. Expects 400 with ProblemDetail response."
          },
          "response": [
            {
              "name": "400 — Validation Error",
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/problem+json" }],
              "body": "{\n  \"type\": \"about:blank\",\n  \"title\": \"Bad Request\",\n  \"status\": 400,\n  \"detail\": \"Validation failed\",\n  \"errors\": {\n    \"name\": \"must not be blank\",\n    \"distance\": \"must not be null\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Update Race (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Name was updated', function () {",
                  "    pm.expect(pm.response.json().name).to.eql('Mountain Classic 2026');",
                  "});",
                  "pm.test('Distance was updated', function () {",
                  "    pm.expect(pm.response.json().distance).to.eql('HALF_MARATHON');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mountain Classic 2026\",\n  \"distance\": \"HALF_MARATHON\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{command_url}}/api/races/{{race_id}}",
              "host": ["{{command_url}}"],
              "path": ["api", "races", "{{race_id}}"]
            },
            "description": "Partially updates a race. All fields are optional — only provided fields are changed."
          },
          "response": [
            {
              "name": "200 — Race Updated",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"name\": \"Mountain Classic 2026\",\n  \"distance\": \"HALF_MARATHON\"\n}"
            }
          ]
        },
        {
          "name": "Update Race — Partial (name only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Name was updated', function () {",
                  "    pm.expect(pm.response.json().name).to.eql('Coastal Trail');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coastal Trail\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{command_url}}/api/races/{{race_id}}",
              "host": ["{{command_url}}"],
              "path": ["api", "races", "{{race_id}}"]
            },
            "description": "Demonstrates partial update — only the name is changed, distance is left as-is."
          },
          "response": []
        },
        {
          "name": "Delete Race",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
