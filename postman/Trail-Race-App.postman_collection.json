    {
      "name": "Auth",
      "description": "Authentication endpoints. Run a Login request first to populate `jwt_token`. Subsequent requests inherit the token automatically.",
      "item": [
        {
          "name": "Login as Administrator (Command)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response contains token', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('jwt_token', json.token);",
                  "    console.log('jwt_token saved (admin)');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@trailrace.com\",\n  \"password\": \"admin123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{command_url}}/api/auth/login",
              "host": ["{{command_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login as Administrator via the command service. Saves `jwt_token` automatically.\n\nCredentials: `admin@trailrace.com` / `admin123`"
          },
          "response": [
            {
              "name": "200 — Login Successful",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiJ9...\"\n}"
            }
          ]
        },
        {
          "name": "Login as Applicant (Command)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response contains token', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('jwt_token', json.token);",
                  "    pm.collectionVariables.set('jwt_token_applicant', json.token);",
                  "    console.log('jwt_token saved (applicant via command)');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"applicant123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{command_url}}/api/auth/login",
              "host": ["{{command_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login as Applicant via the command service. Saves `jwt_token` (overwriting any previous value) and `jwt_token_applicant`.\n\nCredentials: `jane@example.com` / `applicant123`"
          },
          "response": []
        },
        {
          "name": "Login as Applicant (Query)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response contains token', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('jwt_token', json.token);",
