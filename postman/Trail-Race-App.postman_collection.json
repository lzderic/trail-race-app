    {
      "name": "Applications — Command (port 8081)",
      "description": "Mutating operations on Applications. Accessible to both **Administrator** and **Applicant** roles.",
      "item": [
        {
          "name": "Create Application (as Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has required fields', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('firstName', 'John');",
